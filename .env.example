# PostgreSQL
DB_APP_USER=peluqueria
DB_APP_PASSWORD=CambiaEstaPassword1

# SMTP para enviar los codigos de acceso.
# Con Gmail: activa la verificacion en dos pasos y genera una "contraseña de aplicacion"
# en https://myaccount.google.com/apppasswords - no uses tu contraseña normal.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# JWT: cambia este secreto por uno propio y largo (min. 32 caracteres)
JWT_SECRET=

# El primer usuario que inicie sesion con este email se convertira en administrador
ADMIN_EMAIL=

# El primer usuario que inicie sesion con este email se convertira en superadministrador
# (puede hacer todo lo de un administrador, y ademas ver la lista de usuarios y ascender
# a otros a administrador). Opcional: dejalo vacio si no quieres superadministrador.
SUPERADMIN_EMAIL=

# Origenes permitidos para peticiones al backend (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# URL del frontend, usada para construir los enlaces de los emails (registro,
# invitaciones...). En Docker Compose el frontend se sirve en el puerto 3000;
# si usas "npm run dev" sin Docker, cambiala a http://localhost:5173.
FRONTEND_URL=http://localhost:3000

# Login con Google (mismo Client ID para el backend, que verifica el token,
# y para el frontend, que dibuja el boton oficial de Google). Opcional: si se
# deja vacio, el boton de Google simplemente no se muestra.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
